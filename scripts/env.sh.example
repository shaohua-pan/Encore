# Shared paths for the scripts under scripts/.
#
# Copy this file to scripts/env.sh and point the variables at your own
# checkouts, weights and output directories. scripts/env.sh is git-ignored.
#
#   cp scripts/env.sh.example scripts/env.sh
#   ${EDITOR:-vi} scripts/env.sh

# --- Model weights ----------------------------------------------------------
# Directory holding the LTX-2.3 base weights and the Gemma text encoder.
# See the README for the exact files to download.
export MODEL_ROOT="/path/to/models"

export CHECKPOINT_PATH="${MODEL_ROOT}/ltx-2.3-22b-dev.safetensors"
export DISTILLED_LORA="${MODEL_ROOT}/ltx-2.3-22b-distilled-lora-384.safetensors"
export SPATIAL_UPSAMPLER_PATH="${MODEL_ROOT}/ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
export GEMMA_ROOT="${MODEL_ROOT}/gemma-3-12b-it-qat-q4_0-unquantized"

# Encore's trained LoRA (includes the condition routing table).
# Download it from the release listed in the README.
export ENCORE_LORA="${MODEL_ROOT}/encore_weight.safetensors"

# --- Data -------------------------------------------------------------------
# Root for raw clips, preprocessed latents and validation samples.
export DATA_ROOT="/path/to/data"

# --- Outputs ----------------------------------------------------------------
export OUTPUT_ROOT="/path/to/outputs"

# --- Runtime ----------------------------------------------------------------
# GPUs visible to the script. Inference needs one GPU with >= 48 GB;
# training was run on 8 GPUs per node.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
